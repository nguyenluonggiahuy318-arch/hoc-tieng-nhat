  "grammar": [
    {
      "pattern": "N1 は N2 です",
      "meaning": "N1 là N2",
      "explain": "Mẫu câu cơ bản nhất để giới thiệu. <b>は</b> là trợ từ đánh dấu chủ đề — viết là は nhưng đọc là <b>wa</b>. <b>です</b> đứng cuối câu, làm câu lịch sự.",
      "note": "です đọc gần như \"des\": âm u cuối rất nhẹ.",
      "source": "minna",
      "examples": [
        {
          "jp": "わたしは がくせいです。",
          "romaji": "Watashi wa gakusei desu.",
          "vi": "Tôi là học sinh."
        },
        {
          "jp": "わたしは ベトナムじんです。",
          "romaji": "Watashi wa Betonamujin desu.",
          "vi": "Tôi là người Việt Nam."
        },
        {
          "jp": "やまださんは せんせいです。",
          "romaji": "Yamada-san wa sensei desu.",
          "vi": "Anh/chị Yamada là giáo viên."
        }
      ]
    },
    {
      "pattern": "N1 は N2 じゃ ありません",
      "meaning": "N1 không phải là N2",
      "explain": "Thể phủ định của です. <b>じゃ ありません</b> dùng khi nói; <b>では ありません</b> trang trọng hơn, hay dùng khi viết (は ở đây cũng đọc là wa → <i>dewa</i>).",
      "source": "minna",
      "examples": [
        {
          "jp": "わたしは せんせいじゃ ありません。",
          "romaji": "Watashi wa sensei ja arimasen.",
          "vi": "Tôi không phải là giáo viên."
        },
        {
          "jp": "リンさんは にほんじんでは ありません。",
          "romaji": "Rin-san wa Nihonjin dewa arimasen.",
          "vi": "Linh không phải là người Nhật."
        }
      ]
    },
    {
      "pattern": "N1 は N2 ですか",
      "meaning": "N1 có phải là N2 không?",
      "explain": "Thêm <b>か</b> vào cuối câu là thành câu hỏi, không cần đổi thứ tự từ. Khi nói thì lên giọng ở か. Trả lời bằng <b>はい</b> (vâng) hoặc <b>いいえ</b> (không).",
      "note": "Trong câu trả lời thường bỏ chủ ngữ vì người nghe đã biết đang nói về ai.",
      "source": "minna",
      "examples": [
        {
          "jp": "ミラーさんは アメリカじんですか。",
          "romaji": "Mirā-san wa Amerikajin desu ka.",
          "vi": "Anh Miller có phải là người Mỹ không?"
        },
        {
          "jp": "……はい、アメリカじんです。",
          "romaji": "Hai, Amerikajin desu.",
          "vi": "Vâng, là người Mỹ."
        },
        {
          "jp": "やまださんは いしゃですか。",
          "romaji": "Yamada-san wa isha desu ka.",
          "vi": "Anh Yamada có phải là bác sĩ không?"
        },
        {
          "jp": "……いいえ、いしゃじゃ ありません。せんせいです。",
          "romaji": "Iie, isha ja arimasen. Sensei desu.",
          "vi": "Không, không phải bác sĩ. Là giáo viên."
        }
      ]
    },

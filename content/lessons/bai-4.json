  "grammar": [
    {
      "pattern": "いま ～じ ～ふん です",
      "meaning": "Bây giờ là … giờ … phút",
      "explain": "Nói giờ: số + <b>じ</b> (giờ), số + <b>ふん / ぷん</b> (phút); <b>はん</b> = rưỡi. Hỏi giờ bằng <b>いま なんじですか</b>, hỏi phút bằng <b>なんぷん</b>.",
      "note": "4じ = <b>よじ</b>, 7じ = <b>しちじ</b>, 9じ = <b>くじ</b>. Phút biến âm: いっぷん, さんぷん, よんぷん, ろっぷん, はっぷん, じゅっぷん. Bảng đầy đủ ở mục <a href=\"#so-dem\">Số đếm</a>.",
      "source": "video",
      "examples": [
        {
          "jp": "いま よじ ごふんです。",
          "romaji": "Ima yoji gofun desu.",
          "vi": "Bây giờ là 4 giờ 5 phút."
        },
        {
          "jp": "いま なんじですか。",
          "romaji": "Ima nanji desu ka.",
          "vi": "Bây giờ là mấy giờ?"
        },
        {
          "jp": "……くじはんです。",
          "romaji": "Kuji han desu.",
          "vi": "9 giờ rưỡi."
        }
      ]
    },
    {
      "pattern": "V ます / V ません / V ました / V ませんでした",
      "meaning": "Động từ lịch sự: hiện tại – phủ định – quá khứ",
      "explain": "Đuôi <b>ます</b> dùng cho hiện tại, thói quen và tương lai; đổi đuôi để phủ định hoặc nói về quá khứ.<table class=\"ktable\"><tr><th></th><th>Khẳng định</th><th>Phủ định</th></tr><tr><td>Hiện tại / tương lai</td><td>おきます</td><td>おきません</td></tr><tr><td>Quá khứ</td><td>おきました</td><td>おきませんでした</td></tr></table>",
      "note": "Thời của câu nằm ở đuôi động từ, không nằm ở chủ ngữ: きのう … ました, あした … ます.",
      "source": "video",

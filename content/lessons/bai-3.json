  "grammar": [
    {
      "pattern": "ここ / そこ / あそこ は ばしょ です",
      "meaning": "Chỗ này / chỗ đó / chỗ kia là (địa điểm)",
      "explain": "Bộ こ・そ・あ cho <b>nơi chốn</b>: <b>ここ</b> chỗ người nói đang đứng, <b>そこ</b> chỗ người nghe, <b>あそこ</b> chỗ xa cả hai. Hỏi \"ở đâu\" bằng <b>どこ</b>.<table class=\"ktable\"><tr><th></th><th>Gần người nói</th><th>Gần người nghe</th><th>Xa cả hai</th><th>Hỏi</th></tr><tr><td>Đồ vật</td><td>これ</td><td>それ</td><td>あれ</td><td>どれ</td></tr><tr><td>＋ N</td><td>この</td><td>その</td><td>あの</td><td>どの</td></tr><tr><td>Nơi chốn</td><td>ここ</td><td>そこ</td><td>あそこ</td><td>どこ</td></tr><tr><td>Lịch sự</td><td>こちら</td><td>そちら</td><td>あちら</td><td>どちら</td></tr></table>",
      "source": [
        "pdf",
        "video"
      ],
      "examples": [
        {
          "jp": "ここは きょうしつです。",
          "romaji": "Koko wa kyōshitsu desu.",
          "vi": "Chỗ này là phòng học."
        },
        {
          "jp": "そこは かいだんです。",
          "romaji": "Soko wa kaidan desu.",
          "vi": "Chỗ đó là cầu thang."
        },
        {
          "jp": "あそこは トイレです。",
          "romaji": "Asoko wa toire desu.",
          "vi": "Chỗ kia là nhà vệ sinh."
        },
        {
          "jp": "ここは きょうしつですか。",
          "romaji": "Koko wa kyōshitsu desu ka.",
          "vi": "Chỗ này là phòng học phải không?"
        },
        {
          "jp": "……はい、そうです。きょうしつです。",
          "romaji": "Hai, sō desu. Kyōshitsu desu.",
          "vi": "Vâng, đúng vậy. Là phòng học."
        },
        {
          "jp": "あそこは エレベーターですか。",
          "romaji": "Asoko wa erebētā desu ka.",
          "vi": "Chỗ kia là thang máy phải không?"
        },
        {
          "jp": "……いいえ、そうじゃ ありません。トイレです。",
          "romaji": "Iie, sō ja arimasen. Toire desu.",
          "vi": "Không, không phải vậy. Là nhà vệ sinh."
        },
        {
          "jp": "かいぎしつは どこですか。",
          "romaji": "Kaigishitsu wa doko desu ka.",
          "vi": "Phòng họp thì ở đâu?"
        },
        {
          "jp": "……あそこです。",
          "romaji": "Asoko desu.",
          "vi": "Ở chỗ kia."
        }
      ]
    },
    {
      "pattern": "こちら / そちら / あちら / どちら",
      "meaning": "Đằng này / đằng đó / đằng kia / đằng nào",
      "explain": "Cách nói <b>lịch sự</b> của ここ / そこ / あそこ / どこ, chỉ phương hướng hoặc nơi chốn. Hay dùng ở khách sạn, cửa hàng, công ty.",
      "source": [
        "pdf",
        "video"
      ],
      "examples": [
        {
          "jp": "こちらは うけつけです。",
          "romaji": "Kochira wa uketsuke desu.",
          "vi": "Đằng này là quầy lễ tân."
        },
        {
          "jp": "そちらは ロビーです。",
          "romaji": "Sochira wa robī desu.",
          "vi": "Đằng đó là sảnh."
        },
        {
          "jp": "あちらは じむしょです。",
          "romaji": "Achira wa jimusho desu.",
          "vi": "Đằng kia là văn phòng."
        },
        {
          "jp": "しょくどうは どちらですか。",
          "romaji": "Shokudō wa dochira desu ka.",
          "vi": "Nhà ăn thì ở đằng nào ạ?"
        },
        {
          "jp": "……あちらです。",
          "romaji": "Achira desu.",
          "vi": "Ở đằng kia ạ."
        }
      ]
    },
    {
      "pattern": "ひと / もの は ばしょ です",
      "meaning": "Người / đồ vật thì ở (địa điểm)",
      "explain": "Mẫu ばしょです còn dùng để nói <b>ai đó hoặc cái gì đó đang ở đâu</b>. Hỏi bằng <b>どこですか</b>.",
      "note": "Câu わたしは きょうしつです không có nghĩa \"tôi là phòng học\" — ngữ cảnh cho biết là \"tôi đang ở phòng học\".",
      "source": [
        "pdf",
        "video"
      ],
      "examples": [
        {
          "jp": "わたしは きょうしつです。",
          "romaji": "Watashi wa kyōshitsu desu.",
          "vi": "Tôi ở phòng học."
        },
        {
          "jp": "ざっしは ロビーです。",
          "romaji": "Zasshi wa robī desu.",
          "vi": "Tạp chí thì ở sảnh đợi."
        },
        {
          "jp": "さとうさんは どこですか。",
          "romaji": "Satō-san wa doko desu ka.",
          "vi": "Chị Sato thì ở đâu?"
        },
        {
          "jp": "……しょくどうです。",
          "romaji": "Shokudō desu.",
          "vi": "Ở nhà ăn."
        }
      ]
    },
    {
      "pattern": "N は ～えん です / いくらですか",
      "meaning": "N có giá … yên / bao nhiêu tiền?",
      "explain": "Nói giá: số + <b>えん</b>. Hỏi giá bằng <b>いくらですか</b>. Đọc số lớn xem bảng ở mục <a href=\"#so-dem\">Số đếm</a> — chú ý さんびゃく, ろっぴゃく, はっぴゃく, さんぜん, はっせん.",
      "note": "Tiền Việt: số + ドン (đồng), ví dụ ごまん ドン = 50.000 đồng. Đô-la: ドル.",
      "source": [
        "pdf",
        "video"
      ],
      "examples": [
        {
          "jp": "この かばんは さんぜん はっぴゃく えんです。",
          "romaji": "Kono kaban wa sanzen happyaku en desu.",
          "vi": "Cái cặp này giá 3.800 yên."
        },
        {
          "jp": "あの とけいは いちまん はっせん えんです。",
          "romaji": "Ano tokei wa ichiman hassen en desu.",
          "vi": "Đồng hồ kia giá 18.000 yên."
        },
        {
          "jp": "この くつは いくらですか。",
          "romaji": "Kono kutsu wa ikura desu ka.",
          "vi": "Đôi giày này bao nhiêu tiền ạ?"
        },
        {
          "jp": "……きゅうせん ごひゃく えんです。",
          "romaji": "Kyūsen gohyaku en desu.",
          "vi": "9.500 yên ạ."
        }
      ]
    },
    {
      "pattern": "これ / それ / あれ は くに の N です",
      "meaning": "Cái này / đó / kia là N (xuất xứ) của nước …",
      "explain": "の chỉ <b>xuất xứ</b>: N được sản xuất ở nước nào. Hỏi bằng <b>どこの N ですか</b> (N của nước nào?).",
      "note": "So sánh: だれの (của ai) · なんの (về cái gì) · どこの (của nước nào / công ty nào).",
      "source": [

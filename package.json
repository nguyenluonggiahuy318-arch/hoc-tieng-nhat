{
  "name": "hoc-tieng-nhat",
  "private": true,
  "version": "1.0.0",
  "description": "Web học tiếng Nhật sơ cấp: Hiragana, Katakana, từ vựng và ngữ pháp từng bài (giao diện tiếng Việt).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "stats": "tsx scripts/stats.ts",
    "merge": "tsx scripts/merge.ts",
    "inbox:scan": "tsx scripts/inbox/scan.ts",
    "inbox:done": "tsx scripts/inbox/done.ts",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run validate && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.10.0",
    "fflate": "0.8.3",
    "sharp": "0.34.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  }
}
